# Copy this file to secrets.tfvars and fill in your sensitive values
# DO NOT commit secrets.tfvars to source control
#
# Add secrets.tfvars to .gitignore to prevent accidental commits

# ============================================================================
# REDCAP COMMUNITY CREDENTIALS
# ============================================================================
# Used to download REDCap from community.projectredcap.org
# Leave blank if using redcap_zip_url (direct download) instead

redcap_community_username = ""  # Your REDCap community username
redcap_community_password = ""  # Your REDCap community password

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================
# SQL admin credentials stored in Key Vault

sql_admin_name = "sqladmin"  # MySQL admin username (default: sqladmin)
sql_password   = ""          # MySQL admin password (leave blank to auto-generate)

# ============================================================================
# OPTIONAL: REDCAP DIRECT DOWNLOAD
# ============================================================================
# If you have a direct download URL with SAS token, use this instead of community credentials

# redcap_zip_url = "https://your-storage-account.blob.core.windows.net/redcap/redcap_X.X.X.zip?sas-token"

# ============================================================================
# OPTIONAL: SMTP CREDENTIALS (if your SMTP server requires authentication)
# ============================================================================

# smtp_fqdn               = "smtp.example.com"
# smtp_port               = "587"
# smtp_from_email_address = "noreply@example.com"

# ============================================================================
# USAGE
# ============================================================================
# Deploy with:
#   terraform apply -var-file="terraform.tfvars" -var-file="secrets.tfvars"
#
# Or set TF_VAR environment variables:
#   export TF_VAR_subscription_id="your-subscription-id"
#   export TF_VAR_redcap_community_username="your-username"
#   export TF_VAR_redcap_community_password="your-password"
#   terraform apply -var-file="terraform.tfvars"
